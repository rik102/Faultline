# Optional OpenAI-compatible endpoint served from AMD Developer Cloud with vLLM.
# Example: http://YOUR_MI300X_VM:8000/v1/chat/completions
OPENAI_COMPAT_CHAT_URL=
OPENAI_COMPAT_API_KEY=

# Recommended hackathon models:
# Qwen/Qwen2.5-VL-7B-Instruct for multimodal UI screenshot analysis
# Qwen/Qwen2.5-7B-Instruct for text-only agent reasoning
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Browser automation
PLAYWRIGHT_TIMEOUT_MS=20000
